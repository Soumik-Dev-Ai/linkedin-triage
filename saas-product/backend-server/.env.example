# Unipile API Configuration
UNIPILE_API_KEY=
UNIPILE_DSN=

# LLM API Keys — Configure ANY combination for cascade fallback
# The app tries models top-to-bottom. More keys = more resilience.

# 1. Google Gemini (free: 1500 req/day) — https://ai.google.dev
GEMINI_API_KEY=

# 2. Groq (free: 14400 req/day) — https://console.groq.com
GROQ_API_KEY=

# 3. Cerebras (free: 1M tokens/day) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4. Mistral (free experiment tier) — https://console.mistral.ai
MISTRAL_API_KEY=

# 5. DeepSeek ($5 free credit) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 6. OpenAI (paid, optional) — https://platform.openai.com
# OPENAI_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Developer Credentials
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
