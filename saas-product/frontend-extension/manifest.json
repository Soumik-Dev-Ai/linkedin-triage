{
  "manifest_version": 3,
  "name": "LinkedIn AI Triage",
  "version": "1.0.0",
  "description": "Auto-triage LinkedIn messages.",
  "action": {},
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://localhost/*", "https://*.vercel.app/*"],
      "js": ["src/content/bridge.ts"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "https://*.vercel.app/*"
  ]
}
