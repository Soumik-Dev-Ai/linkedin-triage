{
  "manifest_version": 3,
  "name": "AI Triage Bridge",
  "version": "1.0.2",
  "description": "Secure data bridge between LinkedIn and the AI Triage Dashboard.",
  "action": {
    "default_title": "Open AI Triage Dashboard"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["scripts/content-linkedin.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://localhost/*", "https://linkedin-triage.vercel.app/*", "https://aitriage.vercel.app/*"],
      "js": ["scripts/content-dashboard.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://linkedin-triage.vercel.app/*",
    "https://aitriage.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}